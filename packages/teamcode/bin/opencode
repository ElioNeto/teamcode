#!/bin/sh

# POSIX shell wrapper for opencode that uses exec to replace the process
# This ensures VS Code and other terminal emulators see "opencode" as the
# process name instead of "node"

set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Detect platform and architecture
case "$(uname -s)" in
  Darwin) PLATFORM="darwin" ;;
  Linux)  PLATFORM="linux" ;;
  MINGW*|MSYS*|CYGWIN*) PLATFORM="windows" ;;
  *) PLATFORM="$(uname -s)" ;;
esac

case "$(uname -m)" in
  x86_64|amd64) ARCH="x64" ;;
  aarch64|arm64) ARCH="arm64" ;;
  armv7l|arm) ARCH="arm" ;;
  *) ARCH="$(uname -m)" ;;
esac

BASE="opencode-${PLATFORM}-${ARCH}"
BINARY="opencode"
if [ "$PLATFORM" = "windows" ]; then
  BINARY="opencode.exe"
fi

# Check for AVX2 support on x64
supports_avx2() {
  if [ "$ARCH" != "x64" ]; then
    return 1
  fi

  if [ "$PLATFORM" = "linux" ]; then
    if grep -q -i 'avx2' /proc/cpuinfo 2>/dev/null; then
      return 0
    fi
    return 1
  fi

  if [ "$PLATFORM" = "darwin" ]; then
    if sysctl -n hw.optional.avx2_0 2>/dev/null | grep -q '^1$'; then
      return 0
    fi
    return 1
  fi

  return 1
}

# Check for musl libc on Linux
is_musl() {
  if [ "$PLATFORM" != "linux" ]; then
    return 1
  fi

  if [ -f /etc/alpine-release ]; then
    return 0
  fi

  if ldd --version 2>&1 | grep -q -i 'musl'; then
    return 0
  fi

  return 1
}

# Determine which binary names to try
if [ "$ARCH" = "x64" ]; then
  if supports_avx2; then
    BASELINE=""
  else
    BASELINE="-baseline"
  fi
else
  BASELINE=""
fi

if is_musl; then
  MUSL="-musl"
else
  MUSL=""
fi

# Build list of candidate binary names
NAMES=""
if [ "$ARCH" = "x64" ]; then
  if [ -n "$BASELINE" ]; then
    NAMES="${BASE}${BASELINE}${MUSL} ${BASE}${MUSL} ${BASE}${BASELINE} ${BASE}"
  else
    NAMES="${BASE}${MUSL} ${BASE}${BASELINE}${MUSL} ${BASE} ${BASE}${BASELINE}"
  fi
else
  NAMES="${BASE}${MUSL} ${BASE}"
fi

# Find the binary in node_modules
find_binary() {
  local dir="$1"
  while [ "$dir" != "/" ]; do
    if [ -d "$dir/node_modules" ]; then
      for name in $NAMES; do
        local candidate="$dir/node_modules/$name/bin/$BINARY"
        if [ -f "$candidate" ]; then
          echo "$candidate"
          return 0
        fi
      done
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

# Check for cached binary or environment override
if [ -n "$OPENCODE_BIN_PATH" ]; then
  RESOLVED="$OPENCODE_BIN_PATH"
elif [ -f "$SCRIPT_DIR/.opencode" ]; then
  RESOLVED="$SCRIPT_DIR/.opencode"
else
  RESOLVED="$(find_binary "$SCRIPT_DIR")" || {
    echo "It seems that your package manager failed to install the right version of the opencode CLI for your platform. You can try manually installing one of: $NAMES" >&2
    exit 1
  }
fi

# Use exec to replace this process with the opencode binary
# This ensures the OS process table shows "opencode" instead of "sh" or "node"
exec "$RESOLVED" "$@"
